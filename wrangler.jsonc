{
  // Static site served from ./public. A small Worker (src/worker.js) runs first on page
  // requests to redirect www → apex and add trailing slashes with permanent 301s.
  "name": "thefastdesigns",
  "compatibility_date": "2025-09-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/*", "!/assets/*", "!/images/*", "!/*.png", "!/*.svg", "!/*.xml", "!/*.txt", "!/*.webmanifest"]
  }
}
